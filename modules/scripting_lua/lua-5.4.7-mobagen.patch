+/* MOBAGEN LOCAL PATCH (modules/scripting_lua, todo 17): trap-based error
+ * recovery. The stock ISO-C path needs setjmp/longjmp; the wasm guests are
+ * built import-free (-nostdlib / -sSTANDALONE_WASM), where neither the
+ * emscripten JS-setjmp lowering (`env.invoke_*` imports — the loader binds
+ * no `env` module) nor wasi-libc's setjmp (requires the wasm-EH proposal —
+ * WAMR 2.4.5 fast-interp traps EH opcodes, AOT has none, and the browser
+ * backend must stay MVP+bulk+atomics) can serve. Instead LUAI_THROW stages
+ * the error out-of-band and TRAPS; the host observes the failed invoke and
+ * re-enters the guest through mobagen_scripting_error_v1 (declared here),
+ * which finishes the unwind Lua's luaD_throw would have done (the same
+ * shape luaD_throw itself uses for a thread with NO error handler:
+ * luaE_resetthread-style state restoration) and returns the error text.
+ * See portable_lua_plugin.c for the host-side half. */
+#if defined(MOBAGEN_LUA_TRAP_RECOVERY)
+#define luai_jmpbuf int  /* dummy storage; the trap path never reads it */
+#endif
+
 #include "lua.h"
 
 #include "lapi.h"
