+ * snapshots the error state and TRAPS; recovery happens through
+ * mobagen_scripting_error_v1. */
+void mobagen_lua_stage_trap_error(lua_State *L, int errcode);
+#define LUAI_THROW(L,c)		mobagen_lua_stage_trap_error(L, (c)->status)
+#define LUAI_TRY(L,c,a)		{ a }
